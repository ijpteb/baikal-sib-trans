# Байкал Сиб-Транс — настройки веб-сервера Apache для папки сайта (public / public_html)

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType image/avif .avif
    AddType application/manifest+json .webmanifest
</IfModule>

# Скрытые и служебные файлы не отдаём никогда
<FilesMatch "(^\.|(?i)\.(sqlite|sqlite3|db|sql|log|ini|md|bak|old|orig|swp|sh|command|lock|dist|env|zip|tar|gz)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Проверки сертификата Let's Encrypt пропускаем как есть
    RewriteRule ^\.well-known/ - [L]

    # Принудительный переход на HTTPS.
    # Проще включить его переключателем в панели хостинга (см. README-RU.md, раздел 7).
    # Если переключателя нет — уберите # в четырёх строках ниже, но только ПОСЛЕ того,
    # как подключите SSL-сертификат. Переключатель и эти строки вместе не включайте.
    # Строка с X-HTTPS нужна для Timeweb: там о защищённом соединении сообщает этот заголовок.
    # RewriteCond %{HTTPS} !=on
    # RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    # RewriteCond %{HTTP:X-HTTPS} !=1
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Все адреса, кроме настоящих файлов, обрабатывает index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Заголовки безопасности и кэш для статических файлов
# (для страниц сайта заголовки выставляет сам PHP)
<IfModule mod_headers.c>
    <FilesMatch "(?i)\.(css|js|mjs|woff2|svg|webp|avif|png|jpe?g|gif|ico|txt)$">
        Header set X-Content-Type-Options "nosniff"
        Header set Referrer-Policy "strict-origin-when-cross-origin"
    </FilesMatch>
    <FilesMatch "(?i)\.(css|js|mjs|woff2|svg|webp|avif|png|jpe?g|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml image/x-icon
</IfModule>
